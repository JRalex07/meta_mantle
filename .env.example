# MetaMantle Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# NEVER commit production credentials to source control.

# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Optional Cloudflare invalidation credentials (only used by its API adapter)
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# Optional Database / API Endpoints
API_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://localhost:5432/metamantle

