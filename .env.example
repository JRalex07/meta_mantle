# MetaMantle Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# NEVER commit production credentials to source control.

# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Optional CDN Invalidation Credentials (Only required if using programmatic CDN purging)
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

CLOUDFRONT_DISTRIBUTION_ID=YOUR_CLOUDFRONT_DISTRIBUTION_ID
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Optional Database / API Endpoints
API_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://user:password@localhost:5432/metamantle
